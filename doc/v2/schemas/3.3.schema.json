{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module 3.3 Input Schema",
  "type": "object",
  "required": [
    "project_name",
    "processing_description",
    "purpose_and_necessity",
    "lawful_basis",
    "risk_assessment",
    "mitigation_measures",
    "residual_risk",
    "attachments"
  ],
  "properties": {
    "project_name": {
      "type": "string"
    },
    "processing_description": {
      "type": "string"
    },
    "purpose_and_necessity": {
      "type": "string"
    },
    "lawful_basis": {
      "type": "string"
    },
    "risk_assessment": {
      "type": "string"
    },
    "mitigation_measures": {
      "type": "string"
    },
    "residual_risk": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "file_role",
              "file_name",
              "file_format",
              "storage_uri"
            ],
            "properties": {
              "file_role": {
                "type": "string"
              },
              "file_name": {
                "type": "string",
                "minLength": 1
              },
              "file_format": {
                "type": "string"
              },
              "storage_uri": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "checksum_sha256": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ],
        "properties": {
          "file_role": {
            "type": "string",
            "enum": [
              "data_flow_diagram",
              "security_policy",
              "dpa",
              "other"
            ]
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "file_format": {
            "type": "string",
            "enum": [
              "docx",
              "pdf",
              "png",
              "jpg"
            ]
          },
          "storage_uri": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "checksum_sha256": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}