{
  "title": "3.2 BCR审核",
  "steps": [
    {
      "title": "企业与审查项",
      "fields": [
        {"name": "company_name", "label": "企业名称", "type": "text", "default": "示例集团"},
        {"name": "code", "label": "审查代码", "type": "select", "options": ["3.2-C1", "3.2-C2", "3.2-C3", "3.2-C4", "3.2-C5", "3.2-C6", "3.2-C7", "3.2-C8", "3.2-C9", "3.2-C10"], "default": "3.2-C1"},
        {"name": "title", "label": "审查标题", "type": "text", "default": "结构完整性"},
        {"name": "score", "label": "符合度", "type": "select", "options": ["compliant", "partial", "non_compliant"], "default": "partial"}
      ]
    },
    {
      "title": "审查结论",
      "fields": [
        {"name": "finding", "label": "发现问题", "type": "textarea", "default": "章节覆盖不完整"},
        {"name": "legal_basis", "label": "法律依据", "type": "text", "default": "GDPR 第47条"},
        {"name": "recommendation", "label": "整改建议", "type": "textarea", "default": "补齐约束力与权利章节"},
        {"name": "evidence", "label": "证据", "type": "text", "default": "BCR-v1 第3章"}
      ]
    }
  ]
}
