{
  "title": "4.1 对华数据流动合规",
  "steps": [
    {
      "title": "业务与数据范围",
      "fields": [
        {"name": "company_name", "label": "企业名称", "type": "text", "default": "示例企业"},
        {"name": "transfer_purpose", "label": "传输目的", "type": "textarea", "default": "全球客服与风控"},
        {"name": "data_categories", "label": "数据类型（逗号分隔）", "type": "text", "default": "账户信息,设备信息"},
        {"name": "sensitive_data_flags", "label": "敏感数据标记（逗号分隔，可空）", "type": "text", "default": "生物识别"}
      ]
    },
    {
      "title": "接收方与链路",
      "fields": [
        {"name": "recipient_entity_name", "label": "接收方实体", "type": "text", "default": "US ServiceCo"},
        {"name": "recipient_country_region", "label": "接收方国家/地区", "type": "text", "default": "United States"},
        {"name": "recipient_role", "label": "接收方角色", "type": "select", "options": ["processor", "controller", "subprocessor", "affiliate", "vendor"], "default": "processor"},
        {"name": "is_restricted_party", "label": "是否受限实体", "type": "checkbox", "default": false},
        {"name": "transfer_chain", "label": "传输链路", "type": "textarea", "default": "CN -> US processor -> subprocessor"}
      ]
    }
  ]
}
