          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未说明数据可携带权",
          "risk_analysis_template": "未说明个人信息的转移/可携带权，《个人信息保护法》第45条规定个人有权请求将个人信息转移至其指定的处理者。",
          "recommendation_template": "建议补充数据可携带权的行使条件和方式。"
        }
      ],
      "citations": [
        {"source": "个人信息保护法", "article": "第44条", "snippet": "个人对其个人信息的处理享有知情权、决定权，有权限制或者拒绝他人对其个人信息进行处理..."},
        {"source": "个人信息保护法", "article": "第45条", "snippet": "个人有权向个人信息处理者查阅、复制其个人信息..."},
        {"source": "个人信息保护法", "article": "第46条", "snippet": "个人发现其个人信息不准确或者不完整的，有权请求个人信息处理者更正、补充..."},
        {"source": "个人信息保护法", "article": "第47条", "snippet": "有下列情形之一的，个人信息处理者应当主动删除个人信息..."}
      ],
      "checklist_requirement": {"document_type": ["privacy_policy"], "required": true, "missing_severity": "HIGH"}
    },

    "LIABILITY": {
      "display_name": "违约责任与争议解决",
      "priority": 4,
      "document_applicability": ["scc_contract", "dpa"],
      "keywords": ["违约责任", "赔偿", "责任承担", "免责", "争议解决", "管辖", "仲裁", "诉讼", "法律适用"],
      "multi_label_keywords": {
        "ONWARD_TRANSFER": ["第三方", "再转移", "转委托"],
        "GOVERNMENT_ACCESS": ["政府", "执法", "披露"]
      },
      "required_groups": [
        ["违约责任", "责任承担", "赔偿"],
        ["争议解决", "管辖", "仲裁", "诉讼"]
      ],
      "dsl_checks": [
        {
          "id": "foreign_court_jurisdiction",
          "pattern": "香港.*法院|新加坡.*法院|美国.*法院|境外.*管辖|域外.*法院|外国.*法院|英国.*法院",
          "severity": "HIGH",
          "problem_type": "NON_COMPLIANT",
          "title_template": "争议解决约定为境外法院管辖",
          "risk_analysis_template": "条款约定境外法院管辖，对于标准合同，根据《个人信息出境标准合同办法》第五条，应选择中国内地有管辖权的法院或仲裁机构。",
          "recommendation_template": "应将争议解决管辖修改为中国内地有管辖权的法院或仲裁机构。"
        },
        {
          "id": "other_agreement_priority",
          "pattern": "其他协议.*优先|优先.*商业.*协议|以.*商业合同.*为准|主协议.*优先|其他约定.*为准",
          "severity": "HIGH",
          "problem_type": "NON_COMPLIANT",
          "title_template": "其他协议优先条款可能与标准合同正文冲突",
          "risk_analysis_template": "标准合同正文要求其他约定不得与正文冲突。如有'其他协议优先'条款，可能削弱标准合同的约束力。",
          "recommendation_template": "应删除或修改该条款，确保标准合同正文条款优先适用。"
        },
        {
          "id": "liability_cap",
          "pattern": "责任上限|赔偿上限|最高.*赔偿|责任.*限额|不超过.*合同金额",
          "severity": "MEDIUM",
          "problem_type": "NON_COMPLIANT",
          "title_template": "责任上限条款需审慎评估",
          "risk_analysis_template": "包含责任上限条款。需评估其是否不当地限制了数据主体的损害赔偿权利。",
          "recommendation_template": "建议审查责任上限是否合理，确保不违反法律的强制性规定。"
        }
      ],
      "citations": [
        {"source": "个人信息出境标准合同办法", "article": "第五条", "snippet": "个人信息处理者与境外接收方约定争议解决方式时，应当选择中国内地有管辖权的法院或者仲裁机构..."},
        {"source": "民法典", "article": "合同编相关条款", "snippet": ""}
      ],
      "checklist_requirement": {"document_type": [], "required": false, "missing_severity": "MEDIUM"}
    },

