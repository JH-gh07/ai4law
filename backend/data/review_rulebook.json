{
  "meta": {
    "version": "2.0",
    "jurisdiction": "cn",
    "description": "Enhanced review rulebook with 23 clause types, DSL checks, document checklists, and risk weights for Chinese data protection document review.",
    "last_updated": "2025-06-02"
  },

  "clause_types": {

    "DATA_PROCESSING_SCOPE": {
      "display_name": "数据处理目的与范围",
      "priority": 6,
      "document_applicability": ["privacy_policy", "scc_contract", "dpa"],
      "keywords": ["处理目的", "处理范围", "处理方式", "数据类型", "个人信息种类", "数据字段", "处理活动"],
      "multi_label_keywords": {
        "DATA_MINIMIZATION": ["最小必要", "最小化", "限于", "直接相关"],
        "PURPOSE_LIMITATION": ["目的限制", "限定目的", "不超过", "未经同意不得用于其他目的"]
      },
      "required_groups": [
        ["处理目的", "目的"],
        ["处理范围", "范围", "数据类型", "个人信息种类"],
        ["处理方式", "方式"]
      ],
      "dsl_checks": [
        {
          "id": "vague_purpose",
          "pattern": "根据需要|视情况|可能|必要时.*处理|包括但不限于.*目的",
          "severity": "MEDIUM",
          "problem_type": "AMBIGUOUS_LANGUAGE",
          "title_template": "处理目的表述存在模糊空间",
          "risk_analysis_template": "条款使用了模糊表述，可能导致处理目的超出用户合理预期或监管审查时无法明确界定处理范围。",
          "recommendation_template": "建议将处理目的细化至具体业务场景，避免使用'可能'、'视情况'等不确定措辞。"
        },
        {
          "id": "no_legal_basis",
          "pattern_missing": ["依据", "法律", "同意", "合同", "法定", "第13条", "合法基础"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "缺少处理合法性基础说明",
          "risk_analysis_template": "未找到个人信息处理的合法性基础引用。《个人信息保护法》第13条要求明确数据处理的法律基础。",
          "recommendation_template": "应明确说明数据处理所依据的合法性基础，例如'履行合同所必需'或'取得个人同意'等。"
        }
      ],
      "citations": [
        {"source": "个人信息保护法", "article": "第13条", "snippet": "符合下列情形之一的，个人信息处理者方可处理个人信息..."},
        {"source": "个人信息保护法", "article": "第17条", "snippet": "个人信息处理者在处理个人信息前，应当以显著方式、清晰易懂的语言真实、准确、完整地向个人告知..."}
      ],
      "checklist_requirement": {"document_type": ["privacy_policy"], "required": true, "missing_severity": "HIGH"}
    },

    "CONSENT_NOTICE": {
      "display_name": "同意与告知",
      "priority": 6,
      "document_applicability": ["privacy_policy", "scc_contract", "dpa"],
      "keywords": ["同意", "告知", "境外接收方", "联系方式", "单独同意", "撤回", "知情", "授权", "通知", "提示"],
      "multi_label_keywords": {
        "SENSITIVE_PI": ["敏感个人信息", "单独同意", "个人敏感信息"],
        "CROSS_BORDER_TRANSFER": ["境外", "跨境", "传输"]
      },
      "required_groups": [
        ["告知", "通知", "提示"],
        ["境外接收方", "接收方"],
        ["联系方式", "联系"],
        ["同意", "单独同意"]
      ],
      "dsl_checks": [
        {
          "id": "no_withdrawal_mechanism",
          "pattern_missing": ["撤回", "撤销", "取消同意", "退出"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "缺少撤回同意机制说明",
          "risk_analysis_template": "未提供撤回同意的途径。《个人信息保护法》第15条要求提供便捷的撤回同意方式。",
          "recommendation_template": "应明确说明撤回同意的具体操作路径和方式。"
        },
        {
          "id": "no_separate_consent_vague",
          "pattern": "默认.*同意|一经使用即视为同意|继续使用即表示同意|使用本服务即同意",
          "severity": "HIGH",
          "problem_type": "NON_COMPLIANT",
          "title_template": "同意机制表述违反知情同意原则",
          "risk_analysis_template": "条款使用了默认同意或默示同意表述，不符合《个人信息保护法》要求的充分知情、自愿、明确同意原则。",
          "recommendation_template": "应改为明确、主动的同意机制，不得以默示方式获取同意。"
        }
      ],
      "citations": [
        {"source": "个人信息保护法", "article": "第39条", "snippet": "个人信息处理者向中华人民共和国境外提供个人信息的，应当向个人告知..."},
        {"source": "个人信息保护法", "article": "第15条", "snippet": "基于个人同意处理个人信息的，个人有权撤回其同意..."}
      ],
      "checklist_requirement": {"document_type": ["privacy_policy", "scc_contract"], "required": true, "missing_severity": "HIGH"}
    },

    "SECURITY_MEASURES": {
      "display_name": "安全措施",
      "priority": 5,
      "document_applicability": ["privacy_policy", "scc_contract", "dpa"],
      "keywords": ["安全措施", "加密", "访问控制", "应急", "审计", "安全", "防护", "脱敏", "去标识化", "匿名化", "备份", "日志", "监控"],
      "multi_label_keywords": {
        "DATA_MINIMIZATION": ["脱敏", "匿名化", "去标识化", "最小化"],
        "INCIDENT_RESPONSE": ["应急", "事件", "预案", "演练"]
      },
      "required_groups": [
        ["安全措施", "安全"],
        ["加密", "脱敏", "去标识化", "匿名化"],
        ["访问控制", "权限"],
        ["应急", "响应", "事件"]
      ],
      "dsl_checks": [
        {
          "id": "vague_security",
          "pattern": "合理.*安全|必要.*安全|适当.*安全|技术措施.*保障",
          "severity": "MEDIUM",
          "problem_type": "AMBIGUOUS_LANGUAGE",
          "title_template": "安全措施描述过于笼统",
          "risk_analysis_template": "未具体说明采取的技术和管理安全措施，仅使用'合理'、'必要'等笼统描述，无法评估安全保障的充分性。",
          "recommendation_template": "建议列出具体的安全措施，如TLS传输加密、AES-256存储加密、基于角色的访问控制(RBAC)、定期安全审计等。"
        },
        {
          "id": "no_encryption_specified",
          "pattern_missing": ["加密", "TLS", "SSL", "HTTPS", "AES", "SM2", "SM4", "传输安全"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未说明数据加密措施",
          "risk_analysis_template": "未找到数据传输和存储加密的明确说明，无法确认是否采取了必要的技术保护措施。",
          "recommendation_template": "建议明确说明数据在传输和存储过程中采用的加密算法和协议。"
        }
      ],
      "citations": [
        {"source": "个人信息保护法", "article": "第38条", "snippet": "个人信息处理者应当采取必要措施保障所处理的个人信息的安全..."},
        {"source": "数据安全法", "article": "第27条", "snippet": "开展数据处理活动应当依照法律、法规的规定，建立健全全流程数据安全管理制度..."}
      ],
      "checklist_requirement": {"document_type": ["privacy_policy", "scc_contract", "dpa"], "required": true, "missing_severity": "HIGH"}
    },

    "CROSS_BORDER_TRANSFER": {
      "display_name": "数据出境",
      "priority": 7,
      "document_applicability": ["privacy_policy", "scc_contract", "dpa"],
      "keywords": ["数据出境", "跨境", "境外", "存储地点", "传输", "出境", "域外", "管辖", "接收方"],
      "multi_label_keywords": {
        "ONWARD_TRANSFER": ["再转移", "第三方", "转委托", "子处理者"],
        "GOVERNMENT_ACCESS": ["执法", "政府", "请求", "披露"],
        "SUPPLEMENTARY_MEASURES": ["补充措施", "保护认证", "标准合同"]
      },
      "required_groups": [
        ["境外", "跨境", "数据出境", "传输"],
        ["存储地点", "存储", "服务器", "数据中心"],
        ["传输", "接收方"]
      ],
      "dsl_checks": [
        {
          "id": "no_legal_mechanism",
          "pattern_missing": ["安全评估", "标准合同", "保护认证", "认证", "评估", "合同"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未说明出境合法机制",
          "risk_analysis_template": "未找到数据出境的合法路径说明（安全评估/标准合同/保护认证），《个人信息保护法》第38条要求选择其中一种。",
          "recommendation_template": "应明确说明数据出境所依据的合法机制。"
        },
        {
          "id": "no_storage_location",
          "pattern_missing": ["存储地点", "存储位置", "服务器位置", "数据中心", "境外服务器", "机房"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未明确境外存储地点",
          "risk_analysis_template": "涉及数据出境但未明确境外数据的存储地点，无法评估接收方所在地法律环境和保护能力。",
          "recommendation_template": "应明确境外数据存储的具体国家/地区和服务器位置。"
        },
        {
          "id": "no_retention_period",
          "pattern_missing": ["保存期限", "存储期限", "保存期间", "保留时间", "存储时间", "期限"],
          "severity": "HIGH",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未约定境外数据保存期限",
          "risk_analysis_template": "未约定境外数据的保存期限，违反《个人信息保护法》第19条关于保存期限的要求。",
          "recommendation_template": "应明确境外数据的保存期限及到期后的处理方式。"
        },
        {
          "id": "no_overseas_law_impact",
          "pattern_missing": ["境外法律", "当地法律", "外国法律", "法律环境", "保护水平"],
          "severity": "MEDIUM",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未评估境外法律环境影响",
          "risk_analysis_template": "未评估境外接收方所在地法律环境对数据保护的影响。",
          "recommendation_template": "建议补充对接收方所在地数据保护法律环境的评估。"
        }
      ],
      "citations": [
        {"source": "个人信息保护法", "article": "第38条", "snippet": "个人信息处理者因业务等需要，确需向中华人民共和国境外提供个人信息的，应当具备下列条件之一..."},
        {"source": "数据出境安全评估办法", "article": "第4条", "snippet": "数据处理者向境外提供数据，有下列情形之一的，应当通过所在地省级网信部门向国家网信部门申报数据出境安全评估..."}
      ],
      "checklist_requirement": {"document_type": ["scc_contract"], "required": true, "missing_severity": "HIGH"}
    },

    "RIGHTS_REQUEST": {
      "display_name": "主体权利行使",
      "priority": 5,
      "document_applicability": ["privacy_policy", "scc_contract", "dpa"],
      "keywords": ["权利", "查询", "复制", "更正", "删除", "撤回同意", "查阅", "转移", "解释说明", "投诉", "举报", "拒绝"],
      "multi_label_keywords": {
        "AUTOMATED_DECISION": ["自动化决策", "算法", "自动处理"],
        "MINOR_PROTECTION": ["未成年", "儿童", "14岁"]
      },
      "required_groups": [
        ["查询", "访问", "查阅"],
        ["更正", "修改"],
        ["删除"],
        ["撤回同意", "撤回"]
      ],
      "dsl_checks": [
        {
          "id": "no_response_time",
          "pattern_missing": ["30日", "15日", "工作日", "及时", "合理期间", "15个工作日", "30个工作日"],
          "severity": "MEDIUM",
          "problem_type": "MISSING_REQUIREMENT",
          "title_template": "未说明权利请求响应时限",
          "risk_analysis_template": "未承诺响应个人信息主体权利请求的具体时限，依据《个人信息保护法》，一般应在15-30个工作日内响应。",
          "recommendation_template": "建议明确权利请求的响应时限，如'将在15个工作日内响应'。"
        },
        {
          "id": "no_transfer_right",
          "pattern_missing": ["转移", "可携带", "导出"],
