{
  "case_id": "01_minimal",
  "description": "CN Flow数据流合规检查—云服务监控数据出境美国，涉及生物识别标记",
  "input": {
    "company_name": "云服务科技有限公司",
    "transfer_purpose": "云服务监控与客服协同",
    "data_categories": [
      "账户信息",
      "设备日志"
    ],
    "sensitive_data_flags": [
      "biometric"
