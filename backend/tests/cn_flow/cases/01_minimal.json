    "min_counts": {
      "chapters": 4,
      "risk_items": 1,
      "output_files": 9
    },
    "output_roles_contains": [
      "markdown",
      "docx",
      "pdf",
      "xlsx",
      "zip",
      "facts_json",
      "evidence_chain_json"
    ],
    "output_formats": [
      "md",
      "docx",
      "pdf",
      "xlsx",
      "json",
      "zip"
    ]
  }
}
