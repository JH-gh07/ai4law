def run_diagnosis(settings: Settings, provider_name: str) -> dict[str, Any]:
    trace_dir = settings.storage_dir / "traces" / f"diagnosis_fresh_{provider_name.lower().replace(' ', '_')}"
    trace = TraceRecorder(trace_dir=trace_dir, task_id=f"diagnosis-{provider_name}")
    token = current_trace.set(trace)
    try:
        service = DiagnosisService()
        service._llm_client = __import__("backend.common.llm.client", fromlist=["LLMClient"]).LLMClient(settings)
        service.agents = __import__("backend.modules.diagnosis.agents", fromlist=["create_diag_agents"]).create_diag_agents(service._llm_client)
        renderer = DiagnosisReportRenderer(llm_client=service._llm_client)
        answers = diagnosis_payload()
        result = service.evaluate(answers, trace=trace)
        outputs = renderer.render("智造未来科技有限公司", answers, result)
        trace.write_manifest()
        ensure_provider_usage(trace_dir)
        usage = sum_trace_usage(trace_dir)
        return {
            "module": "diagnosis",
            "provider": provider_name,
            "trace_dir": str(trace_dir),
            "recommended_path": result.recommended_path,
            "outputs": {k: str(v) for k, v in outputs.items()},
            **usage,
        }
    finally:
        current_trace.reset(token)


def run_assessment(settings: Settings, provider_name: str, review_upload_path: str) -> dict[str, Any]:
    service = AssessmentService(
        llm_client=__import__("backend.common.llm.client", fromlist=["LLMClient"]).LLMClient(settings),
        legal_api_service=__import__("backend.services.legal_api_service", fromlist=["DeliLegalService"]).DeliLegalService(settings),
    )
    payload = assessment_payload(review_upload_path)
    task_id = f"fresh-assessment-{provider_name.lower().replace(' ', '_')}"
    trace_dir = settings.storage_dir / "traces" / f"assessment_{task_id}"
    trace = TraceRecorder(trace_dir=trace_dir, task_id=task_id)
    result = service.generate_report(payload, task_id=task_id, trace=trace)
    trace.write_manifest()
    ensure_provider_usage(trace_dir)
    usage = sum_trace_usage(trace_dir)
    return {
        "module": "assessment",
        "provider": provider_name,
        "trace_dir": str(trace_dir),
        "report_path": result.report_path,
        "outputs": result.output_files,
        **usage,
    }


def run_review(settings: Settings, provider_name: str, review_docx_path: str) -> dict[str, Any]:
    container = AppContainer(settings)
    container.task_dispatcher = __import__("backend.services.task_dispatcher", fromlist=["InlineTaskDispatcher"]).InlineTaskDispatcher()
    container.review_service.task_dispatcher = container.task_dispatcher
    init_db(container.engine)
    db = container.session_factory()
    try:
        user_id = "fresh-review-user"
        review_input_dir = settings.upload_dir / "fresh-review-inputs"
        review_input_dir.mkdir(parents=True, exist_ok=True)
        review_input_path = review_input_dir / Path(review_docx_path).name
        shutil.copyfile(review_docx_path, review_input_path)
        payload = review_payload(str(review_input_path))
        task = container.review_service._create_task_from_request(db, user_id, payload)
        trace_dir = settings.storage_dir / "traces" / f"review_{task.id}"
        trace = TraceRecorder(trace_dir=trace_dir, task_id=task.id)
        token = current_trace.set(trace)
        try:
            container.review_service._run_pipeline(task.id, user_id)
            refreshed = container.review_service._require_task(db, task.id, user_id)
            result = container.review_service._build_generate_response(db, user_id, refreshed)
            trace.write_manifest()
        finally:
            current_trace.reset(token)
        ensure_provider_usage(trace_dir)
        usage = sum_trace_usage(trace_dir)
        return {
            "module": "review",
            "provider": provider_name,
            "trace_dir": str(trace_dir),
            "report_path": result.report_path,
            "outputs": result.output_files,
            "risk_level": result.risk_level,
            **usage,
        }
    finally:
        db.close()


def write_markdown(results: list[dict[str, Any]]) -> None:
    lines = [
        "# Fresh CN Token Compare",
        "",
        "| Module | Provider | Prompt Tokens | Completion Tokens | Total Tokens | LLM Calls |",
        "| --- | --- | ---: | ---: | ---: | ---: |",
    ]
    for item in results:
        lines.append(
            f"| {item['module']} | {item['provider']} | {item['prompt_tokens']} | {item['completion_tokens']} | {item['total_tokens']} | {item['llm_calls']} |"
        )
    RESULT_MD.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> None:
    only_provider = os.environ.get("AI4LAW_ONLY_PROVIDER", "").strip()
    only_module = os.environ.get("AI4LAW_ONLY_MODULE", "").strip()
    if RUN_ROOT.exists():
        shutil.rmtree(RUN_ROOT)
    RUN_ROOT.mkdir(parents=True, exist_ok=True)
    review_docx = build_review_case_docx()
    results: list[dict[str, Any]] = []

    for provider in PROVIDERS:
        if only_provider and provider["provider_id"] != only_provider:
            continue
        settings = build_settings(provider["provider_id"], provider["model"])
        init_isolated_db(settings)
        core_settings_module.get_settings.cache_clear()
        core_settings_module.get_settings = lambda: settings  # type: ignore[assignment]
        os.environ.pop("http_proxy", None)
        os.environ.pop("https_proxy", None)
        os.environ.pop("all_proxy", None)
        os.environ.pop("HTTP_PROXY", None)
        os.environ.pop("HTTPS_PROXY", None)
        os.environ.pop("ALL_PROXY", None)

        if not only_module or only_module == "diagnosis":
            results.append(run_diagnosis(settings, provider["provider_name"]))
        if not only_module or only_module == "assessment":
            results.append(run_assessment(settings, provider["provider_name"], str(review_docx)))
        if not only_module or only_module == "review":
            results.append(run_review(settings, provider["provider_name"], str(review_docx)))

    RESULT_JSON.write_text(json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8")
    write_markdown(results)


if __name__ == "__main__":
    main()
