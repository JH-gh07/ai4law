def sum_trace_usage(trace_dir: Path) -> dict[str, Any]:
    prompt = 0
    completion = 0
    total = 0
    calls = 0
    for path in sorted(trace_dir.glob("*.json")):
        if path.name == "manifest.json":
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        detail = ((payload.get("payload") or {}).get("detail") or {}) if isinstance(payload, dict) else {}
        if detail.get("tool") != "llm_chat":
            continue
        usage = detail.get("usage") or {}
        if usage.get("usage_source") != "provider":
            continue
        calls += 1
        prompt += int(usage.get("prompt_tokens") or 0)
        completion += int(usage.get("completion_tokens") or 0)
        total += int(usage.get("total_tokens") or 0)
    return {
        "prompt_tokens": prompt,
        "completion_tokens": completion,
        "total_tokens": total,
        "llm_calls": calls,
    }


def ensure_provider_usage(trace_dir: Path) -> None:
    usage = sum_trace_usage(trace_dir)
    if usage["llm_calls"] <= 0 or usage["total_tokens"] <= 0:
        raise RuntimeError(f"No provider usage found in trace: {trace_dir}")


