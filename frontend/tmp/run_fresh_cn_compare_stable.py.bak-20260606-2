def load_runtime_provider_map() -> dict[str, dict[str, Any]]:
    payload = json.loads((ROOT / "storage" / "runtime_settings.json").read_text(encoding="utf-8"))
    llm = payload.get("llm") or {}
    providers = llm.get("providers") or []
    result: dict[str, dict[str, Any]] = {}
    for item in providers:
        if isinstance(item, dict) and item.get("id"):
            result[str(item["id"])] = item
    return result


def build_settings(provider_id: str, model: str) -> Settings:
    provider_map = load_runtime_provider_map()
    active = provider_map[provider_id]
    storage_dir = RUN_ROOT / f"{provider_id}__{model.replace('/', '_')}" / "storage"
    settings = Settings(
        database_url=f"sqlite:///{(storage_dir / 'fresh.db').as_posix()}",
        storage_dir=storage_dir,
    )
    settings._runtime_llm_providers = [
        {
            "id": provider_id,
            "name": active.get("name") or provider_id,
            "provider_type": active.get("provider_type") or "openai_compatible",
            "api_url": active.get("api_url") or "",
            "api_key": active.get("api_key") or "",
            "model": model,
            "enabled": True,
            "timeout": int(active.get("timeout") or 60),
        }
    ]
    settings._runtime_llm_active_provider_id = provider_id
    settings.storage_dir.mkdir(parents=True, exist_ok=True)
    settings.upload_dir.mkdir(parents=True, exist_ok=True)
    settings.report_dir.mkdir(parents=True, exist_ok=True)
    return settings


