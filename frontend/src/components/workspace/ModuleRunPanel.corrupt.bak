      documentReviewValues.collection_purpose_disclosed ? "宸叉姭闇叉敹闆嗕笌澶勭悊鐩殑" : "鏈厖鍒嗘姭闇叉敹闆嗕笌澶勭悊鐩殑",
      documentReviewValues.processing_method_disclosed ? "宸叉姭闇插鐞嗘柟寮? : "鏈厖鍒嗘姭闇插鐞嗘柟寮?,
      documentReviewValues.category_disclosed ? "宸叉姭闇蹭釜浜轰俊鎭绫? : "鏈厖鍒嗘姭闇蹭釜浜轰俊鎭绫?,
