              </ul>
            </article>
          ) : null}

          {userFacingResult.highlights.length > 0 ? (
            <article className="runner-user-block">
              <h4>{lang === "zh" ? "鍏抽敭缁撴灉" : "Key Findings"}</h4>
              <ul>
                {userFacingResult.highlights.map((item, index) => (
                  <li key={`${item}-${index}`}>{item}</li>
                ))}
              </ul>
            </article>
          ) : null}

          <article className="runner-user-block">
            <h4>{lang === "zh" ? "寤鸿涓嬩竴姝? : "Recommended Next Steps"}</h4>
            <ul>
              {userFacingResult.nextSteps.map((item, index) => (
                <li key={`${item}-${index}`}>{item}</li>
              ))}
            </ul>
          </article>
        </section>
      ) : (
        <div className="runner-empty-card">{t("runResultPlaceholder")}</div>
      )}

      <div className="runner-preview-hint">
        {responseData
          ? (lang === "zh" ? "缁撴灉宸茬敓鎴愶紝绯荤粺浼氳嚜鍔ㄥ垏鎹㈠埌鈥滄姤鍛娾€濋〉绛捐繘琛屽墠绔瑙堛€? : "Result generated. The workspace switches to the report tab for preview.")
          : (lang === "zh" ? "杩愯瀹屾垚鍚庯紝鎶ュ憡鍐呭灏嗗湪鈥滄姤鍛娾€濋〉绛句腑棰勮銆? : "Generated reports will be previewed in the report tab.")}
      </div>
      {error ? <div className="runner-error">{error}</div> : null}
    </section>
  );
}
