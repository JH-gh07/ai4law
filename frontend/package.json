{
  "name": "ai4law-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare:pdfjs": "mkdir -p public/pdfjs && cp -R node_modules/pdfjs-dist/cmaps public/pdfjs/ && cp -R node_modules/pdfjs-dist/standard_fonts public/pdfjs/",
    "predev": "npm run prepare:pdfjs",
    "dev": "vite",
    "prebuild": "npm run prepare:pdfjs",
    "build": "tsc -b && vite build",
    "generate:api": "bash ../scripts/generate_api_types.sh",
    "test": "vitest run",
    "test:dev-cases:api": "vitest run tests/contract/dev-test-cases.api.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
