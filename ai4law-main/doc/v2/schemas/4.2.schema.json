{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module 4.2 Input Schema",
  "type": "object",
  "required": [
    "business_model",
    "data_lifecycle",
    "notice_and_consent",
    "consumer_rights_process",
    "opt_out_and_sale_sharing",
    "attachments"
  ],
  "properties": {
    "business_model": {
      "type": "string"
    },
    "data_lifecycle": {
      "type": "string"
    },
    "notice_and_consent": {
      "type": "string"
    },
    "consumer_rights_process": {
      "type": "string"
    },
    "opt_out_and_sale_sharing": {
      "type": "string"
    },
    "vendor_management": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "file_role",
              "file_name",
              "file_format",
              "storage_uri"
            ],
            "properties": {
              "file_role": {
                "type": "string"
              },
              "file_name": {
                "type": "string",
                "minLength": 1
              },
              "file_format": {
                "type": "string"
              },
              "storage_uri": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "checksum_sha256": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ],
        "properties": {
          "file_role": {
            "type": "string",
            "enum": [
              "privacy_policy",
              "rights_sop",
              "data_map",
              "vendor_list",
              "other"
            ]
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "file_format": {
            "type": "string",
            "enum": [
              "docx",
              "pdf",
              "url",
              "xlsx",
              "csv"
            ]
          },
          "storage_uri": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "checksum_sha256": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}