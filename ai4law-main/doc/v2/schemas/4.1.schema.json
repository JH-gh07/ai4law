{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module 4.1 Input Schema",
  "type": "object",
  "required": [
    "transfer_purpose",
    "data_categories",
    "sensitive_data_flags",
    "recipient_entities",
    "transfer_chain",
    "attachments"
  ],
  "properties": {
    "transfer_purpose": {
      "type": "string"
    },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sensitive_data_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipient_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_name",
          "country_region",
          "entity_role"
        ],
        "properties": {
          "entity_name": {
            "type": "string"
          },
          "country_region": {
            "type": "string"
          },
          "entity_role": {
            "type": "string",
            "enum": [
              "processor",
              "controller",
              "subprocessor",
              "affiliate",
              "vendor"
            ]
          },
          "is_restricted_party": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "transfer_chain": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "file_role",
              "file_name",
              "file_format",
              "storage_uri"
            ],
            "properties": {
              "file_role": {
                "type": "string"
              },
              "file_name": {
                "type": "string",
                "minLength": 1
              },
              "file_format": {
                "type": "string"
              },
              "storage_uri": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "checksum_sha256": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ],
        "properties": {
          "file_role": {
            "type": "string",
            "enum": [
              "data_inventory",
              "entity_inventory",
              "supporting_material"
            ]
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "file_format": {
            "type": "string",
            "enum": [
              "xlsx",
              "csv",
              "docx",
              "pdf"
            ]
          },
          "storage_uri": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "checksum_sha256": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}