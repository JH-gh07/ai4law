{
  "title": "2.3 认证/标准合同路径（PIPIA）",
  "steps": [
    {
      "title": "企业基本信息",
      "fields": [
        {"name": "company_name", "label": "企业名称", "type": "text", "default": "示例科技"},
        {"name": "company_uscc", "label": "统一社会信用代码", "type": "text", "default": "91310000XXXXXXXXXX"},
        {"name": "industry", "label": "行业", "type": "text", "default": "互联网SaaS"},
        {"name": "is_ciio", "label": "是否 CIIO", "type": "checkbox", "default": false},
        {"name": "processing_person_count", "label": "处理个人信息规模", "type": "number", "min": 0, "step": 1000, "default": 230000},
        {"name": "outbound_pi_count", "label": "出境普通个人信息规模", "type": "number", "min": 0, "step": 1000, "default": 46000},
        {"name": "outbound_spi_count", "label": "出境敏感个人信息规模", "type": "number", "min": 0, "step": 100, "default": 2500}
      ]
    },
    {
      "title": "出境场景与范围",
      "fields": [
        {"name": "route_type", "label": "路径类型", "type": "select", "options": ["scc_filing", "certification"], "default": "scc_filing"},
        {"name": "purpose", "label": "出境目的", "type": "textarea", "default": "境外客服与系统运维"},
        {"name": "recipient_name", "label": "境外接收方", "type": "text", "default": "OceanStar Technology Inc."},
        {"name": "recipient_country_region", "label": "接收方国家/地区", "type": "text", "default": "美国加州"},
        {"name": "legal_basis", "label": "处理合法性基础", "type": "text", "default": "合同履行必要"},
        {"name": "pi_categories", "label": "普通个人信息类别（逗号分隔）", "type": "text", "default": "账户信息,联系方式,日志信息"},
        {"name": "spi_categories", "label": "敏感个人信息类别（逗号分隔）", "type": "text", "default": "身份认证信息"},
        {"name": "subject_volume", "label": "数据主体规模", "type": "number", "min": 0, "step": 1000, "default": 46000}
      ]
    },
    {
      "title": "权利保障与应急",
      "fields": [
        {"name": "notice_mechanism", "label": "告知机制", "type": "textarea", "default": "隐私政策+弹窗"},
        {"name": "consent_mechanism", "label": "同意机制", "type": "text", "default": "单独同意"},
        {"name": "dsar_channel", "label": "权利请求渠道", "type": "text", "default": "privacy@example.com"},
        {"name": "retention_policy", "label": "保存与删除策略", "type": "textarea", "default": "到期删除+最短必要"},
        {"name": "incident_response_sla_hours", "label": "事件响应SLA（小时）", "type": "number", "min": 1, "step": 1, "default": 24},
        {"name": "escalation_path", "label": "升级路径", "type": "text", "default": "DPO -> 法务 -> 管理层"},
        {"name": "attachment_role", "label": "附件角色", "type": "select", "options": ["scc_contract", "certification_material", "internal_policy", "supporting_evidence"], "default": "scc_contract"}
      ]
    }
  ]
}
