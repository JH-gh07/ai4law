{
  "title": "3.4 TIA草案生成",
  "steps": [
    {
      "title": "传输工具与主体",
      "fields": [
        {"name": "transfer_tool", "label": "传输工具", "type": "select", "options": ["scc", "bcr", "derogation"], "default": "scc"},
        {"name": "data_exporter_profile", "label": "数据出口方画像", "type": "textarea", "default": "EU Exporter A"},
        {"name": "data_importer_profile", "label": "数据进口方画像", "type": "textarea", "default": "US Importer B"}
      ]
    },
    {
      "title": "第三国评估与措施",
      "fields": [
        {"name": "third_country_assessment", "label": "第三国法律环境评估", "type": "textarea", "default": "存在政府访问风险"},
        {"name": "supplementary_measures", "label": "补充措施", "type": "textarea", "default": "端到端加密、严格密钥管理、访问透明报告"},
        {"name": "final_conclusion", "label": "结论", "type": "textarea", "default": "在补充措施生效前提下SCC可传输"},
        {"name": "attachment_role", "label": "附件角色", "type": "select", "options": ["transfer_agreement", "country_law_analysis", "technical_control_doc", "other"], "default": "transfer_agreement"}
      ]
    }
  ]
}
